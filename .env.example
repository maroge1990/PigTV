# PigTV environment variables. Every one is optional unless marked required; unset = the default shown.
# Most settings are NOT env vars: sources, providers, transcoding, recording and users live in SQLite and are
# edited in the web app's Settings. On Unraid set these on Docker -> PigTV -> Edit, then Apply (recreates it).
# Never put real secrets in this file.

# --- Container and runtime ---
# Required: recording file names use local time.
TZ=Australia/Sydney
PORT=3000
NODE_ENV=production
# The user the container runs as (Unraid's nobody:users). PUID=0 runs as root. See docs/OPERATIONS.md.
PUID=99
PGID=100
# Optional. At least 32 characters. Unset: a random key is created once and kept in data/auth-secret (back it up).
JWT_SECRET=
# Intel VAAPI only.
# LIBVA_DRIVER_NAME=iHD

# --- Playback ---
# A live session nobody has fetched from for this long is removed (seekable sessions: 30 min, fixed).
PIGTV_LIVE_IDLE_TIMEOUT_SEC=300
# The stall watchdog kills an ffmpeg that has written no file for this long (grace before first output: max of this and 30 s).
PIGTV_STALL_TIMEOUT_MS=20000
# ffmpeg's -dts_delta_threshold for sessions.
PIGTV_DTS_DELTA_THRESHOLD_SEC=60
# Seconds read at full speed before a finite source is paced to real time (0-60). 0 = plain -re.
PIGTV_READRATE_BURST=8
# A channel profile (cached probe) older than this is probed again.
PIGTV_PROFILE_MAX_AGE_DAYS=7
# How long a "taken over" record is kept for GET /api/playback/:id/terminal-status.
PIGTV_TERMINAL_STATUS_TTL_SEC=900
# With a hot standby ready: how long the playing stream may write nothing before the standby takes over (min 3000).
PIGTV_RELAY_SWITCH_MS=10000
# A live play whose segments carry less than this (kbps) over its first 20 s is marked blank. Default 500 from 720p up,
# 250 below; 0 switches it off.
# PIGTV_BLANK_KBPS=500

# --- Shared ingest (Wave 5, Settings -> Playback "Shared provider connection"; docs/SHARED-INGEST.md) ---
# Per stream: the buffer's caps (MB and seconds, whichever is reached first).
# PIGTV_INGEST_BUFFER_MB=48
# PIGTV_INGEST_BUFFER_SEC=20
# A reader this far behind (MB) is dropped rather than slowing everyone.
# PIGTV_INGEST_SLOW_MB=16
# How long a lost connection is retried before every reader is told it ended.
# PIGTV_INGEST_RECONNECT_MS=10000
# How long a stream nobody reads stays open (a quick channel change back reuses it).
# PIGTV_INGEST_LINGER_MS=10000
# R7: default reconnect lag in seconds. Measured channel/provider limits adapt in 2 s steps,
# capped at 28 s under the Apple client's 30 s hold; 3 clean reading hours lower a learned level.
# Without PCR this remains the fixed silence timeout.
# PIGTV_INGEST_BEHIND_SEC=24

# --- Sport ---
# 0 turns off ESPN fixtures completely (no fetch; live/replay uses the guide-only heuristics).
# PIGTV_SPORT_FIXTURES=0

# R12 (0213): the server copies content.db to data/backups before a new build's migrations and
# once a day (newest 7 kept). 0 turns both off.
# PIGTV_DB_BACKUPS=0

# --- Build identity (CI sets these; not normally set by hand) ---
# PIGTV_BUILD=
# PIGTV_COMMIT=dev
# PIGTV_BUILT_AT=
